# Sao chép file này thành .env (file .env đã được .gitignore, không bao giờ commit).
# Trên Netlify: nhập các biến này ở Site configuration > Environment variables.

# Chuỗi kết nối Postgres của Supabase, loại "Transaction pooler" (cổng 6543).
# Supabase: Project > Connect > Transaction pooler > Copy. Thay [YOUR-PASSWORD] bằng mật khẩu database.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres

# Mật khẩu đăng nhập /admin. Đặt dài và khó đoán.
ADMIN_PASSWORD=

# Chuỗi ngẫu nhiên dùng để ký phiên admin (khác với mật khẩu). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
